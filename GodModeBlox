local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/Exunys/Orion/main/Source.lua'))()

local Window = OrionLib:MakeWindow({
    Name = "Game Menu",
    HidePremium = false,
    SaveConfig = true,
})

-- God Mode Butonu (Open/Close)
local godModeEnabled = false

local Tab = Window:MakeTab({
    Name = "Game Modes",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false,
})

Tab:AddButton({
    Name = "Toggle God Mode",  -- Buton adı
    Callback = function()
        godModeEnabled = not godModeEnabled  -- Durum değiştirme
        if godModeEnabled then
            -- God Mode aktif: Sağlık koruma
            game.Players.LocalPlayer.Character.Humanoid.Health = game.Players.LocalPlayer.Character.Humanoid.Health
            game.Players.LocalPlayer.Character.Humanoid.HealthChanged:Connect(function()
                if godModeEnabled then
                    game.Players.LocalPlayer.Character.Humanoid.Health = game.Players.LocalPlayer.Character.Humanoid.Health
                end
            end)
            print("God Mode Activated!")  -- Konsola bilgi yazdırma
        else
            -- God Mode devre dışı: Normal sağlık
            print("God Mode Deactivated!")  -- Konsola bilgi yazdırma
        end
    end,
})

-- Profil Bilgileri Sekmesi
local player = game.Players.LocalPlayer
local profileImageUrl = "https://www.roblox.com/bust-thumbnail/image?userId=" .. player.UserId .. "&width=150&height=150&format=png"

local ProfileTab = Window:MakeTab({
    Name = "Profile",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false,
})

ProfileTab:AddImage({
    Name = "Profile Image",
    Image = profileImageUrl,
    Size = UDim2.new(0, 150, 0, 150),
    Position = UDim2.new(0, 10, 0, 10),
})

ProfileTab:AddLabel({
    Name = "Player Name",
    Text = "Name: " .. player.Name,
    TextSize = 18,
    TextColor = Color3.fromRGB(255, 255, 255),
    Position = UDim2.new(0, 170, 0, 20),
})

ProfileTab:AddLabel({
    Name = "Player ID",
    Text = "ID: " .. player.UserId,
    TextSize = 14,
    TextColor = Color3.fromRGB(255, 255, 255),
    Position = UDim2.new(0, 170, 0, 50),
})

-- X Butonu ile Pencereyi Kapatma
Tab:AddButton({
    Name = "Close Window (X)",
    Callback = function()
        Window:Destroy() -- Pencereyi kapat
    end,
})
